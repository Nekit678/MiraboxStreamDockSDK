"""Registered action and application composition; importing never starts workers."""

from __future__ import annotations

import logging
from time import monotonic

from mirabox_sdk import (
    Action,
    ActionRegistry,
    ApplicationContext,
    CommandFuture,
    JsonObject,
    KeyDownEvent,
    PluginLaunchArguments,
    RuntimeDispatcherConfig,
    SendToPluginEvent,
    StreamDockApplication,
    WillAppearEvent,
    create_stream_dock_application,
)

PLUGIN_UUID = @@UUID_JSON@@
ACTION_UUID = @@ACTION_JSON@@
ACTION_REGISTRY = ActionRegistry[ApplicationContext]()
RUNTIME_CONFIG = RuntimeDispatcherConfig(callback_drain_timeout=1.0, shutdown_timeout=5.0)
logger = logging.getLogger(__name__)


def observe_command(completion: CommandFuture) -> None:
    # Runs on the completing thread; inspect the finished result and return promptly.
    error = completion.exception(timeout=0)
    if error is not None:
        logger.error("Display command failed; exception_type=%s", type(error).__name__)


@ACTION_REGISTRY.register(ACTION_UUID)
class PressAction(Action[JsonObject, ApplicationContext]):
    def render_title(self, title: str) -> None:
        # Acceptance errors propagate to runtime callback diagnostics.
        completion = self.set_title_async(title, deadline=monotonic() + 1.0)
        completion.add_done_callback(observe_command)

    def on_will_appear(self, event: WillAppearEvent) -> None:
        self.render_title("Ready")

    def on_key_down(self, event: KeyDownEvent) -> None:
        self.render_title("Pressed")

    def on_send_to_plugin(self, event: SendToPluginEvent) -> None:
        if event.message.name == "reset":
            self.render_title("Ready")


def build_application(arguments: PluginLaunchArguments) -> StreamDockApplication:
    return create_stream_dock_application(
        arguments,
        action_factory=ACTION_REGISTRY,
        action_dependencies_factory=lambda context: context,
        runtime_config=RUNTIME_CONFIG,
    )
